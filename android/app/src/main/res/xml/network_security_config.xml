<?xml version="1.0" encoding="utf-8"?>
<!-- Dev-host allowlist for plain-HTTP traffic to the local Supabase stack
     (LAN IP, adb-reverse loopback, emulator host loopback). Scoped — not a
     blanket cleartext allow. Update the LAN IP when the dev machine moves
     networks. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.26</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
